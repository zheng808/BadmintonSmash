# Copy to .env (or let scripts/pull-env.sh write .env.dev / .env.prod from the CDK stack outputs).
# Every value here is public: Vite inlines it into the bundle.
VITE_API_URL=https://xxxxxxxx.execute-api.us-west-2.amazonaws.com
VITE_USER_POOL_ID=us-west-2_XXXXXXXXX
VITE_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Cognito hosted domain without https://. When set, "Continue with Google" is shown (outside WeChat).
VITE_OAUTH_DOMAIN=
# Public URL of this app; used for OAuth redirects and share links. Defaults to the current origin.
VITE_WEB_URL=
# Google Maps Platform browser key with the Places API (New) enabled. Optional: without it venues are typed by hand.
VITE_GOOGLE_MAPS_KEY=
# Local development against `npm run dev -w api` (no Cognito): send x-dev-user instead of a JWT.
VITE_DEV_AUTH=0
VITE_DEV_USER=dev-user-1
