# Copy to .env (or .env.dev / .env.prod, generated by scripts/pull-env.sh from CDK outputs).
# All values are public: they are inlined into the client bundle.
EXPO_PUBLIC_API_URL=https://xxxxxxxx.execute-api.us-west-2.amazonaws.com
EXPO_PUBLIC_USER_POOL_ID=us-west-2_XXXXXXXXX
EXPO_PUBLIC_USER_POOL_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REGION=us-west-2
EXPO_PUBLIC_WEB_URL=https://dxxxxxxxxxxxx.cloudfront.net
# Local development against `npm run dev -w api` (no Cognito): set to 1 to send x-dev-user instead of a JWT.
EXPO_PUBLIC_DEV_AUTH=0
EXPO_PUBLIC_DEV_USER=dev-user-1
# Google Maps Platform key with ONLY the Places API (New) enabled. Web: HTTP-referrer restricted to EXPO_PUBLIC_WEB_URL;
# use a separate key (iOS bundle id / Android package restricted) for native builds. Empty = manual venue entry.
EXPO_PUBLIC_GOOGLE_MAPS_KEY=
# Cognito hosted UI domain (without https://). When set, the web app shows "Continue with Google".
EXPO_PUBLIC_OAUTH_DOMAIN=
